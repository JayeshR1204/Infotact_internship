import { HRMSSystem } from './hrms-core.js';

const hrms = new HRMSSystem();

// Seed data for initial layout testing
hrms.addEmployee({ name: "Sarah Connor", email: "s.connor@company.com", department: "Engineering", role: "DevOps Lead", salary: 115000 });
hrms.addEmployee({ name: "Marcus Wright", email: "m.wright@company.com", department: "HR", role: "Talent Acquisition", salary: 75000 });

// DOM Elements
const form = document.getElementById('hrmsForm');
const employeeListContainer = document.getElementById('employeeRows');
const metricTotal = document.getElementById('metricTotal');
const metricPayroll = document.getElementById('metricPayroll');

// Function to update the DOM interface
function updateUI() {
    const metrics = hrms.getDashboardMetrics();
    const currentEmployees = hrms.getEmployees();

    // 1. Update Metric Cards
    if(metricTotal) metricTotal.innerText = metrics.totalEmployees;
    if(metricPayroll) metricPayroll.innerText = `$${metrics.monthlyPayrollExpense}`;

    // 2. Update Employee List Table
    if (employeeListContainer) {
        employeeListContainer.innerHTML = currentEmployees.map(emp => `
            <tr data-id="${emp.id}">
                <td><strong>${emp.id}</strong></td>
                <td>${emp.name}</td>
                <td>${emp.department}</td>
                <td>${emp.role}</td>
                <td><span class="badge-${emp.status.toLowerCase().replace(' ', '-')}">${emp.status}</span></td>
                <td>
                    <button class="btn-action status-toggle" data-id="${emp.id}">Toggle Status</button>
                </td>
            </tr>
        `).join('');
    }
}

// Event Listeners
if (form) {
    form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const formData = {
            name: document.getElementById('empName').value,
            email: document.getElementById('empEmail').value,
            department: document.getElementById('empDept').value,
            role: document.getElementById('empRole').value,
            salary: document.getElementById('empSalary').value
        };

        hrms.addEmployee(formData);
        updateUI();
        form.reset();
    });
}

// Dynamic Action handling (e.g., changing status)
document.addEventListener('click', (e) => {
    if (e.target && e.target.classList.contains('status-toggle')) {
        const empId = e.target.getAttribute('data-id');
        const employee = hrms.employees.find(emp => emp.id === empId);
        if (employee) {
            const nextStatus = employee.status === 'Active' ? 'On Leave' : 'Active';
            employee.updateStatus(nextStatus);
            updateUI();
        }
    }
});

// Initial UI Render
document.addEventListener('DOMContentLoaded', updateUI);
