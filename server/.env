# =========================
# Server Configuration
# =========================
NODE_ENV=development
PORT=5000

# =========================
# MongoDB
# =========================
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_hrms

# =========================
# JWT
# =========================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# =========================
# Encryption
# Used for encrypting PII fields
# =========================
ENCRYPTION_KEY=replace_with_32_character_secret_key

# =========================
# CORS
# =========================
CLIENT_URL=http://localhost:3000

# =========================
# Email (Nodemailer)
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=Enterprise HRMS <your_email@gmail.com>

# =========================
# File Uploads
# =========================
MAX_FILE_SIZE=5242880

# =========================
# Logging
# =========================
LOG_LEVEL=info
